#!/bin/bash
#PBS -N umlp_train
#PBS -q v1_a100
#PBS -l select=1:ncpus=4:mpiprocs=1:ngpus=4:mem=200gb:gpu_type=A100
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

source /net/csefiles/coc-fung-cluster/lingyu/miniconda3/etc/profile.d/conda.sh
conda activate mace-elec

module load CUDA/12.1.1

MODEL_TYPE="mace-medium"
ENV_NAME="mace-elec"

TRAIN_FILE="/net/csefiles/coc-fung-cluster/lingyu/electrolyte/train.xyz"
TEST_FILE="/net/csefiles/coc-fung-cluster/lingyu/electrolyte/test.xyz"
ENERGY_REFERENCE="/net/csefiles/coc-fung-cluster/lingyu/electrolyte/train-mace-residual-energy_reference.json"

RUN_STAMP="$(date +%Y%m%d-%H%M%S)"
RUN_NAME="${RUN_NAME:-${RUN_STAMP}-mace-residual-ref-f10}"
OUTPUT_ROOT="${OUTPUT_ROOT:-/net/csefiles/coc-fung-cluster/lingyu/electrolyte/local_runs}"
CHECKPOINT_DIR="${OUTPUT_ROOT}/${RUN_NAME}/checkpoints"
LOG_DIR="${OUTPUT_ROOT}/${RUN_NAME}/logs"

DEVICES="0,1,3"
BATCH_SIZE="6"
LR="1e-4"
MAX_EPOCHS="5000"
TRAIN_SPLIT="0.9"
E_LOSS_WEIGHT="1.0"
F_LOSS_WEIGHT="10.0"
MONITOR="val/total_loss"
PATIENCE="200"
PER_ATOM_ENERGY_NORMALIZE="0"
ACCELERATOR="gpu"
EVAL_DEVICE=""
LOGGER="wandb"
WANDB_PROJECT="MatterTune-Electrolyte"
# Run name: YYYYMMDD-HHMM + model id (override by exporting WANDB_NAME before qsub)
WANDB_NAME="${WANDB_NAME:-${RUN_NAME}}"
SKIP_EVAL="0"

MATTERTUNE_DIR="/nethome/lkong88/workspace/Electrolyte/MatterTune"
EXAMPLE_DIR="${MATTERTUNE_DIR}/examples/electrolyte"

echo "==================== CHECK INPUTS ===================="
echo "MODEL_TYPE       = ${MODEL_TYPE}"
echo "ENV_NAME         = ${ENV_NAME}"
echo "TRAIN_FILE       = ${TRAIN_FILE}"
echo "TEST_FILE        = ${TEST_FILE}"
echo "ENERGY_REFERENCE = ${ENERGY_REFERENCE}"
echo "CHECKPOINT_DIR   = ${CHECKPOINT_DIR}"
echo "LOG_DIR          = ${LOG_DIR}"
echo "MATTERTUNE_DIR   = ${MATTERTUNE_DIR}"
echo "EXAMPLE_DIR      = ${EXAMPLE_DIR}"
echo "E_LOSS_WEIGHT   = ${E_LOSS_WEIGHT}"
echo "F_LOSS_WEIGHT   = ${F_LOSS_WEIGHT}"
echo "MONITOR         = ${MONITOR}"
echo "PER_ATOM_ENERGY_NORMALIZE = ${PER_ATOM_ENERGY_NORMALIZE}"
echo "LOGGER           = ${LOGGER}"
echo "WANDB_PROJECT    = ${WANDB_PROJECT}"
echo "WANDB_NAME       = ${WANDB_NAME}"
echo "======================================================"

if [[ ! -d "${MATTERTUNE_DIR}" ]]; then
  echo "MatterTune directory not found: ${MATTERTUNE_DIR}" >&2
  exit 1
fi

if [[ ! -f "${EXAMPLE_DIR}/train.py" ]]; then
  echo "train.py not found: ${EXAMPLE_DIR}/train.py" >&2
  exit 1
fi

if [[ ! -f "${TRAIN_FILE}" ]]; then
  echo "Training data not found: ${TRAIN_FILE}" >&2
  echo "Files in $(dirname "${TRAIN_FILE}"):" >&2
  ls -lh "$(dirname "${TRAIN_FILE}")" >&2 || true
  exit 1
fi

if [[ "${SKIP_EVAL}" != "1" && ! -f "${TEST_FILE}" ]]; then
  echo "Test data not found: ${TEST_FILE}" >&2
  echo "Files in $(dirname "${TEST_FILE}"):" >&2
  ls -lh "$(dirname "${TEST_FILE}")" >&2 || true
  exit 1
fi

if [[ ! -f "${ENERGY_REFERENCE}" ]]; then
  echo "Energy reference not found: ${ENERGY_REFERENCE}" >&2
  echo "Files in $(dirname "${ENERGY_REFERENCE}"):" >&2
  ls -lh "$(dirname "${ENERGY_REFERENCE}")" >&2 || true
  exit 1
fi

mkdir -p "${CHECKPOINT_DIR}" "${LOG_DIR}"

CONDA_BASE="$(conda info --base)"
source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${ENV_NAME}"

if [[ "${LOGGER}" == "wandb" ]]; then
  # Online runs: authenticate via environment (never commit keys to this script).
  # Prefer: qsub -v WANDB_API_KEY=... runcase_train.job
  # Or one-time: printf '%s' 'your_key' > ~/.wandb_secret && chmod 600 ~/.wandb_secret
  if [[ -z "${WANDB_API_KEY:-}" && -f "${HOME}/.wandb_secret" ]]; then
    export WANDB_API_KEY="$(tr -d '[:space:]' < "${HOME}/.wandb_secret")"
  fi
  if [[ -z "${WANDB_API_KEY:-}" ]]; then
    echo "WANDB_API_KEY is not set. Export it, use qsub -v WANDB_API_KEY=..., or add ${HOME}/.wandb_secret (chmod 600)." >&2
    exit 1
  fi
  export WANDB_MODE=online
fi

cd "${MATTERTUNE_DIR}"
export PYTHONPATH="${MATTERTUNE_DIR}/src:${PYTHONPATH:-}"

CMD=(
  python "${EXAMPLE_DIR}/train.py"
  --model_type "${MODEL_TYPE}"
  --train_file "${TRAIN_FILE}"
  --test_file "${TEST_FILE}"
  --energy_reference "${ENERGY_REFERENCE}"
  --checkpoint_dir "${CHECKPOINT_DIR}"
  --log_dir "${LOG_DIR}"
  --batch_size "${BATCH_SIZE}"
  --lr "${LR}"
  --max_epochs "${MAX_EPOCHS}"
  --train_split "${TRAIN_SPLIT}"
  --e_loss_weight "${E_LOSS_WEIGHT}"
  --f_loss_weight "${F_LOSS_WEIGHT}"
  --monitor "${MONITOR}"
  --patience "${PATIENCE}"
  --accelerator "${ACCELERATOR}"
  --devices "${DEVICES}"
  --logger "${LOGGER}"
  --wandb_project "${WANDB_PROJECT}"
)

if [[ -n "${WANDB_NAME}" ]]; then
  CMD+=(--wandb_name "${WANDB_NAME}")
fi

if [[ -n "${EVAL_DEVICE}" ]]; then
  CMD+=(--eval_device "${EVAL_DEVICE}")
fi

if [[ "${SKIP_EVAL}" == "1" ]]; then
  CMD+=(--skip_eval)
fi

if [[ "${PER_ATOM_ENERGY_NORMALIZE}" == "1" ]]; then
  CMD+=(--per_atom_energy_normalize)
fi

echo "Running command:"
printf ' %q' "${CMD[@]}"
echo

"${CMD[@]}"
